# ─── Servidor ───────────────────────────────────────────────────────────────
PORT=3000
# Executável do Python. No Windows normalmente "python"; em Docker o venv já
# está no PATH.
PYTHON_BIN=python
# Pasta do CLI Python. Padrão: ./python
PYTHON_DIR=./python
# Onde vivem os jobs (uploads, events.json, highlights.json, clips, montagem).
# Padrão ./python/state já casa com o volume do docker-compose.
STATE_DIR=./python/state

# ─── CS2 / gravação (Fases 2 e 3 — só necessário na máquina que grava) ───────
# 1 = pipeline completo (parse → grava → monta). 0 = só detecção (parse →
# score → vdm); use 0 em Docker/servidor sem GPU nem desktop.
RECORDER_ENABLED=0
# Caminho do executável do CS2.
CS2_EXE=C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\bin\win64\cs2.exe
# Pasta csgo/ do CS2 — o demo + o .vdm são copiados pra cá antes do +playdemo.
CS2_DEMOS_DIR=C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\csgo
# screen = CS2 dirigido pelo console TCP (-netconport) + captura de tela via
# ffmpeg. Único backend implementado (o CS2 ignora PlayCommands de VDM).
RECORDER_BACKEND=screen
HLAE_EXE=
FFMPEG_BIN=ffmpeg
# Porta do console TCP do CS2.
NETCON_PORT=29999
NETCON_CONNECT_TIMEOUT=180
# Segundos deixando o demo tocar normalmente antes do 1º demo_gototick —
# evita "CopyNewEntity: invalid class index ... out of range 0".
RECORD_DEMO_WARMUP=20
# ddagrab (Desktop Duplication, GPU — não congela em captura longa) |
# gdigrab (tela toda) | gdigrab-window (só a janela "Counter-Strike 2")
RECORD_CAPTURE=ddagrab
# Resolução/fps da captura. Deixe == à do seu monitor.
RECORD_RESOLUTION=1920x1080
RECORD_FPS=60
RECORD_TIMEOUT=1800
# Folga (s) antes/depois de cada lance no recorte.
RECORD_CUT_PAD=2.0
# Opcional: dispositivo dshow de áudio pra capturar o som do jogo no backend
# screen (ex.: "virtual-audio-capturer" do screen-capture-recorder, ou
# "CABLE Output (VB-Audio Virtual Cable)"). Vazio = grava sem áudio (a trilha
# da montagem entra por cima).
RECORD_AUDIO_DEVICE=

# ─── Detecção de highlights ────────────────────────────────────────────────
# Filtro PRIMÁRIO de pontuação. Não zera um jogador que teve kills — se
# nenhuma sequência dele passar, o melhor lance entra assim mesmo.
SCORE_MIN=3.0
# Máximo de highlights por jogador.
PER_PLAYER_TOP_N=5
# Segundos antes da 1ª kill e depois da última kill de cada sequência.
CLIP_PREROLL_SECONDS=5
CLIP_POSTROLL_SECONDS=2.5
# Gap máx. (segundos) entre kills pra contarem como a mesma sequência.
SEQUENCE_GAP_SECONDS=8
# 1 = após o score o job PAUSA esperando você escolher jogadores/lances no
# painel (senão os vídeos ficam enormes). 0 = grava todo mundo.
REVIEW_MODE=1

# ─── Montagem (Fase 3) ────────────────────────────────────────────────────
MONTAGE_COMBINED=1
MONTAGE_RESOLUTION=1920x1080
MONTAGE_FPS=60
MONTAGE_MUSIC=./python/assets/music.mp3

# ─── Manutenção ───────────────────────────────────────────────────────────
# Jobs mais antigos que isto são apagados pelo cron do instrumentation.ts.
JOB_TTL_HOURS=72
# Teto de processos Python simultâneos pras chamadas curtas (listar, re-gerar
# vdm). A gravação com CS2 é serializada à parte (1 instância por vez).
MAX_CONCURRENT_PYTHON=4
